<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/words"
        style="@style/Title"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agrega tus propias palabras o crea categorías nuevas."
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="8dp" />
        <Button
            android:id="@+id/btnNewCategory"
            style="@style/ButtonSmall"
            android:layout_marginLeft="10dp"
            android:text="+ Categoría" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/use_in_game"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnDeleteCategory"
            style="@style/ButtonSmall"
            android:layout_marginLeft="10dp"
            android:text="Eliminar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <EditText
            android:id="@+id/editWord"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/new_word_hint"
            android:imeOptions="actionDone"
            style="@style/Input" />
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/add_word"
            style="@style/ButtonPrimary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp" />

    <ListView
        android:id="@+id/listWords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <Button
        android:id="@+id/btnRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/restore_defaults"
        style="@style/ButtonSecondary" />
</LinearLayout>
