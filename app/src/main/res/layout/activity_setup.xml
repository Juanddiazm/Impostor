<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                style="@style/Title"
                android:textSize="26sp" />

            <!-- Game mode -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/game_mode" style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnModeImpostor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:text="@string/mode_impostor"
                        style="@style/ButtonSmall" />
                    <Button
                        android:id="@+id/btnModeUndercover"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="@string/mode_undercover"
                        style="@style/ButtonSmall" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtModeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Players -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/players" style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cantidad de jugadores"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnPlayersMinus" style="@style/Stepper" android:text="−" />
                    <TextView
                        android:id="@+id/txtPlayers"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="5" />
                    <Button android:id="@+id/btnPlayersPlus" style="@style/Stepper" android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/namesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Impostors / infiltrators -->
            <TextView android:id="@+id/txtImpostorsSection"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/impostors" style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/txtImpostorsLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/impostor_count"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnImpostorsMinus" style="@style/Stepper" android:text="−" />
                    <TextView
                        android:id="@+id/txtImpostors"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:text="1" />
                    <Button android:id="@+id/btnImpostorsPlus" style="@style/Stepper" android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowMrWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/mr_white_count"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnMrWhiteMinus" style="@style/Stepper" android:text="−" />
                    <TextView
                        android:id="@+id/txtMrWhite"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/warn"
                        android:text="0" />
                    <Button android:id="@+id/btnMrWhitePlus" style="@style/Stepper" android:text="+" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtInfiltratorsNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/infiltrators_note"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Categories -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/categories" style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">
                <TextView
                    android:id="@+id/txtCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/btnCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_categories"
                    style="@style/ButtonSecondary" />
            </LinearLayout>

            <!-- Options -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Opciones" style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <Switch
                    android:id="@+id/switchHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_for_impostor"
                    android:textSize="15sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/round_time"
                        android:textSize="15sp" />
                    <Button android:id="@+id/btnTimeMinus" style="@style/Stepper" android:text="−" />
                    <TextView
                        android:id="@+id/txtTime"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="@string/no_limit" />
                    <Button android:id="@+id/btnTimePlus" style="@style/Stepper" android:text="+" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/start_game"
        style="@style/ButtonPrimary" />
</LinearLayout>
